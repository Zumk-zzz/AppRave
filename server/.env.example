# Подключение к Postgres из приложения, запущенного на хосте.
# Порт 5433, а не 5432: последний занят нативной службой PostgreSQL.
DATABASE_URL="postgresql://apprave:apprave@localhost:5433/apprave?schema=public"

# Секрет для подписи JWT. В проде обязательно свой, длинный и случайный.
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="30d"

PORT=3000

# Сколько минут держится резерв билета до оплаты
RESERVATION_MINUTES=15

# Номер, вход по которому даёт роль администратора
ADMIN_PHONE="+79000000000"

# Код подтверждения в режиме заглушки. В проде заменяется SMS-провайдером.
DEMO_SMS_CODE="0000"

# Оплата: stub — демонстрация; alfa_test — только тестовый шлюз, реальных денег нет.
PAYMENT_PROVIDER=stub
ALFA_API_BASE=https://alfa.rbsuat.com/payment/rest/
ALFA_USER_NAME=""
ALFA_PASSWORD=""
PAYMENT_RETURN_BASE_URL=""
ALFA_CALLBACK_URL=""

# Только серверный секрет; пусто — вход Mini App не подключён.
TELEGRAM_BOT_TOKEN=""
